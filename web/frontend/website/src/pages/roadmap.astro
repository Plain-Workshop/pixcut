---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { GITHUB_URL, ISSUES_URL } from '../lib/site';

const now = [
  ['Timeline editing', 'Trim, reorder and preview scenes on one visual track, with ripple trim handles.', 'shipped'],
  ['Titles and captions', 'On-canvas text editing, styles and safe-area checks.', 'shipped'],
  ['Audio lanes', 'Multiple audio clips with waveforms, fades and a mixed AAC export.', 'shipped'],
  ['Local MP4 export', 'H.264 export with configurable resolution and quality.', 'shipped'],
  ['Template gallery', 'Editable starter projects for common formats.', 'shipped'],
  ['Project frame rates', '24, 25, 30 and 60 fps projects with per-format FPS.', 'shipped'],
  ['In-app updates', 'Signed updater feed with manual check, verification and restart.', 'shipped'],
  ['Export cancellation', 'Stop a render or FFmpeg encode without touching existing files.', 'shipped'],
  ['Video import and export', 'Import MP4, MOV or M4V clips, preview them with titles, and encode them into the MP4.', 'shipped'],
  ['Video colour, fades and speed', 'The same grade, fades and 0.25–4× speed in the preview and the encoded MP4.', 'shipped'],
  ['WebM and ProRes export', 'VP9/Opus WebM and ProRes 422 masters alongside H.264 and HEVC.', 'shipped'],
  ['Elements', 'Shapes, stickers and hearts with their own color, motion and timing.', 'shipped'],
  ['Photo motion', 'Zoom, pan and Ken Burns presets rendered into the export.', 'shipped'],
  ['Resilient local media', 'Projects open when a file disappears, with clear relinking before saving or exporting.', 'shipped'],
  ['Motion keyframes', 'Animate text and overlay position, scale, rotation and opacity with up to 24 keys per layer.', 'shipped'],
  ['Shape masks', 'Cut photo scenes and media overlays into shapes with feather and inversion in the preview and export.', 'shipped'],
  ['Beat detection', 'Analyze local audio into beat markers and snap photo cuts, without a network or model.', 'shipped'],
  ['Colour balance', 'Hue, vibrance and shadow/highlight split toning shared by preview and export.', 'shipped'],
  ['Media preview controls', 'Arrow through media and control video play, seek, mute and volume without leaving the preview.', 'shipped'],
  ['Video templates and music', 'A bundled motion opener and generated local scores in every template.', 'shipped'],
  ['Streamed local photos', 'Photos stay in the asset store and render through references instead of base64 project data.', 'shipped'],
  ['Portable browser packages', 'Browser exports use the same binary .pixcut ZIP package as the desktop app.', 'shipped'],
];
const next = [
  ['Video overlays and effects', 'Picture-in-picture video tracks and transitions between video clips.', 'planned'],
  ['Multi-track editing', 'Overlay multiple video tracks, gaps and speed curves.', 'planned'],
  ['Native media engine', 'Replace the still-image compositor with a proper preview/export pipeline.', 'planned'],
  ['Signed installers', 'Pipeline now builds and verifies macOS, Windows and Linux; Apple and Windows certificates are the remaining step.', 'planned'],
  ['Bundled codec review', 'Ship a license-vetted FFmpeg configuration or platform encoders.', 'planned'],
];
const later = [
  ['Platform export presets', 'One-click social and broadcast presets on top of the current format builder.', 'exploring'],
  ['Plugin API', 'Community effects and integrations.', 'exploring'],
  ['Accessibility pass', 'Screen-reader and keyboard workflows across the editor.', 'exploring'],
];
const tone: Record<string, string> = { shipped: 'pill-ok', planned: 'pill-warn', exploring: 'pill-neutral' };
---

<BaseLayout title="Roadmap — PixCut" description="The public PixCut roadmap: what is shipped, what comes next and what is still being explored.">
  <section class="page-hero center">
    <div class="container">
      <span class="eyebrow">Roadmap</span>
      <h1>Built in public.<br /><span class="gradient-text">Planned honestly.</span></h1>
      <p class="lede">This is a living plan, not a promise of dates. Priorities change with contributors and real usage.</p>
    </div>
  </section>

  <section class="section" style="padding-top:2.4rem;">
    <div class="container">
      <div class="stack" style="gap:2rem;">
        <div>
          <div class="card-head"><div><h2><Icon name="check" size={18} /> Shipped</h2><p class="card-sub">Available now.</p></div><span class="pill pill-ok">Now</span></div>
          <div class="grid cols-2">
            {now.map(([title, copy, status]) => <article class="card"><h3>{title}</h3><p>{copy}</p><span class={`pill ${tone[status]}`}>{status}</span></article>)}
          </div>
        </div>
        <div>
          <div class="card-head"><div><h2><Icon name="trending" size={18} /> Next</h2><p class="card-sub">Actively wanted; order depends on contributors.</p></div><span class="pill pill-warn">Next</span></div>
          <div class="grid cols-2">
            {next.map(([title, copy, status]) => <article class="card"><h3>{title}</h3><p>{copy}</p><span class={`pill ${tone[status]}`}>{status}</span></article>)}
          </div>
        </div>
        <div>
          <div class="card-head"><div><h2><Icon name="sparkles" size={18} /> Exploring</h2><p class="card-sub">Ideas under discussion; not committed.</p></div><span class="pill pill-neutral">Later</span></div>
          <div class="grid cols-2">
            {later.map(([title, copy, status]) => <article class="card"><h3>{title}</h3><p>{copy}</p><span class={`pill ${tone[status]}`}>{status}</span></article>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container center">
      <span class="eyebrow">Change the order</span>
      <h2 class="section-title">Tell us what matters</h2>
      <p class="section-copy">Open an issue with the use case, or comment on an existing roadmap item. Concrete workflows beat vote counts.</p>
      <div class="hero-actions" style="justify-content:center;margin-top:1.4rem;">
        <a class="btn btn-primary" href={ISSUES_URL} rel="noreferrer"><Icon name="chat" size={17} /> Open an issue</a>
        <a class="btn btn-secondary" href={GITHUB_URL} rel="noreferrer"><Icon name="github" size={17} /> GitHub</a>
      </div>
    </div>
  </section>
</BaseLayout>
