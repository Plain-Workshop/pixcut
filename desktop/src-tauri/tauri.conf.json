{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PixCut",
  "version": "0.1.0",
  "identifier": "studio.pixcut.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PixCut",
        "width": 1440,
        "height": 940,
        "minWidth": 1050,
        "minHeight": 720,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; media-src 'self' blob: data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "msi",
      "appimage",
      "deb"
    ],
    "createUpdaterArtifacts": true,
    "category": "Video",
    "fileAssociations": [
      {
        "ext": [
          "pixcut"
        ],
        "name": "PixCut Project",
        "description": "PixCut video project package",
        "mimeType": "application/x-pixcut",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": [
          "ffmpeg"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZCNTM4NjNDRUM2QzMxODUKUldTRk1XenNQSVpUKzNBd1JRN0daRW1aeDF2UTBNdGFuKytWSVdrc2o1ZU9WYnA4QTQ4U2dMcXcK",
      "endpoints": [
        "https://github.com/Plain-Workshop/pixcut/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
